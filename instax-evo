#!/usr/bin/env python3
"""instax-evo: one-command firmware pipeline for the Fujifilm instax
mini Evo digicam project.

    ./instax-evo build    unpack, mod and repack a ready-to-use
                          FPUPDATE.DAT in out/
    ./instax-evo unpack   only carve the stock firmware into parts
    ./instax-evo inspect  show the SUNP BURN FILE layout
    ./instax-evo catalog  extract A:/B: partition files to out/

`build` writes out/FPUPDATE_MOD.DAT. Copy it to the root of a FAT32
microSD card, insert, then use the camera's FIRMWARE UPGRADE menu.

WARNING: flashing a modified firmware image can permanently brick the
camera. There is no confirmed recovery path for this model. The build
output is provided for research; you flash at your own risk.
"""

import os
import sys
import urllib.request

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(ROOT, "tools"))

import sunp
import mods

FW_PATH = os.path.join(ROOT, "firmware", "FPUPDATE.DAT")
FW_URL = ("https://www.instax.com/mini_evo/en/support/firmware/"
          "firmware.html")
OUT = os.path.join(ROOT, "out")


def ensure_firmware():
    if os.path.exists(FW_PATH):
        return
    os.makedirs(os.path.dirname(FW_PATH), exist_ok=True)
    print(f"downloading stock firmware (~93MB)...")
    print(f"  {FW_URL}")
    urllib.request.urlretrieve(FW_URL, FW_PATH)
    print(f"  saved {FW_PATH}")


def cmd_inspect():
    ensure_firmware()
    import inspect as _i
    _i.main(FW_PATH)


def cmd_unpack():
    ensure_firmware()
    import carve
    carve.carve(FW_PATH, os.path.join(OUT, "carved"))


def cmd_catalog():
    ensure_firmware()
    import fatfs

    data = open(FW_PATH, "rb").read()
    for name, off, size in sunp.parts(data):
        if not name.endswith(".img"):
            continue
        label = name[0]
        fs = fatfs.FatImage(data[off:off + size])
        outdir = os.path.join(OUT, f"{label}_files")
        n = 0
        for path, e in fs.listdir():
            if e.is_dir:
                continue
            dest = os.path.join(outdir, path)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            open(dest, "wb").write(fs.read(path))
            n += 1
        print(f"{label}: extracted {n} files to {outdir}/")


def cmd_build():
    ensure_firmware()
    import carve, repack

    carved = os.path.join(OUT, "carved")
    print("== unpack ==")
    carve.carve(FW_PATH, carved)

    print("\n== apply mods ==")
    code_path = os.path.join(carved, "code")
    code = open(code_path, "rb").read()
    patched, results = mods.apply_mods(code)
    warned = False
    for name, p, ok, msg in results:
        print(f"  [{name}] {'OK' if ok else 'FAIL'} {msg}")
        warned |= not ok
    if warned:
        print("  !! some mods did not apply - firmware version mismatch?")
    open(code_path, "wb").write(patched)

    print("\n== repack ==")
    out_dat = os.path.join(OUT, "FPUPDATE_MOD.DAT")
    repack.repack(carved, out_dat)

    print("\n== verify ==")
    # rebuilt file must parse into the same layout, and every part except
    # 'code' must be byte-identical to stock
    new = open(out_dat, "rb").read()
    old = open(FW_PATH, "rb").read()
    pn = {n: (o, s) for n, o, s in sunp.parts(new)}
    po = {n: (o, s) for n, o, s in sunp.parts(old)}
    assert list(pn) == list(po)
    # the two recomputed integrity fields (see sunp._fix_sums) may
    # legitimately differ from stock: header u32 @0x1FC and final u32.
    exempt = set(range(0x1FC, 0x200)) | set(range(len(new) - 4, len(new)))
    for n in pn:
        if n == "code":
            continue
        o1, s1 = pn[n]
        o2, s2 = po[n]
        assert s1 == s2, n
        bad = [o1 + i for i in range(s1)
               if new[o1 + i] != old[o2 + i] and (o1 + i) not in exempt]
        assert not bad, (n, [hex(x) for x in bad[:8]])
    fsz = sunp.u32(new, 0x10)
    assert sunp._word_sum(new[:fsz]) == 0, "0x1FC checksum field wrong"
    assert sunp._word_sum(new[:len(new) // 4 * 4]) == 0, "tail checksum wrong"
    cn, cs = pn["code"]
    diffs = sum(a != b for a, b in zip(new[cn:cn + cs],
                                       old[cn:cn + cs]))
    print(f"  layout parses: OK, non-code parts identical "
          f"(integrity fields recomputed), code differs in "
          f"{diffs} byte(s)")

    print(f"""
DONE: {out_dat}

To install:
  1. copy FPUPDATE_MOD.DAT to the root of a FAT32 microSD card
  2. rename it to FPUPDATE.DAT
  3. insert card, power on, use the FIRMWARE UPGRADE menu
  4. stock firmware REJECTS it: the signature covers the whole
     image (see docs/research.md). Mods need a bootstrap path
     (UART/ISP) before this file can flash.
""")


USAGE = __doc__
CMDS = {"build": cmd_build, "unpack": cmd_unpack,
        "inspect": cmd_inspect, "catalog": cmd_catalog}

if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in CMDS:
        print(USAGE)
        sys.exit(2)
    CMDS[sys.argv[1]]()
